{
  "expo": {
    "name": "YT Music Player",
    "slug": "ytmusic-background-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ytmusicbackgroundplayer",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "INTERNET"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "bbc29ae4-78af-4a5b-b3b3-6b93b882aaeb"
      }
    }
  }
}
